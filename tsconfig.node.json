{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./.tsbuildcache",
    "tsBuildInfoFile": "./.tsbuildcache/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "manifest.config.ts", "package.json"]
}
